# Copy to dojo/.env (bot host only — NEVER commit real secrets)

DISCORD_BOT_TOKEN=your_bot_token
DOJO_GUILD_ID=123456789012345678
DOJO_PROOF_SECRET=generate_a_long_random_string_at_least_32_chars

# Channels (right-click → Copy ID with Developer Mode on)
DOJO_CHANNEL_WAITING_ROOM=123456789012345678
DOJO_CHANNEL_VERIFY_SETUP=123456789012345678

# Role names must match your Discord server exactly
DOJO_ROLE_VERIFIED=Verified
DOJO_ROLE_WHITE_BELT=White Belt
DOJO_ROLE_TRACK_C1=Track-Alpha
DOJO_ROLE_TRACK_C2=Track-LLM
DOJO_ROLE_TRACK_C3=Track-Systems

# Comma-separated Discord user IDs for break-glass admin
DOJO_ADMIN_USER_IDS=
